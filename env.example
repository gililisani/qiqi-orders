# ============================================================================
# Qiqi Partners Hub — environment variables
# Every variable the code reads is listed here (WP12). Placeholders only —
# real values live in .env.local (gitignored) and Vercel project settings.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Direct Postgres access for schema dumps / audits (owner's machine only)
SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://partners.qiqiglobal.com
# Auth provider selector (defaults to supabase)
AUTH_PROVIDER=supabase
# Comma-separated user IDs that bypass every permission check (owner account)
SUPER_ADMIN_IDS=

# --- NetSuite ---------------------------------------------------------------
NETSUITE_ACCOUNT_ID=your_netsuite_account_id
NEXT_PUBLIC_NETSUITE_ACCOUNT_ID=your_netsuite_account_id
NETSUITE_CONSUMER_KEY=your_netsuite_consumer_key
NETSUITE_CONSUMER_SECRET=your_netsuite_consumer_secret
NETSUITE_TOKEN_ID=your_netsuite_token_id
NETSUITE_TOKEN_SECRET=your_netsuite_token_secret
NETSUITE_REALM=your_netsuite_realm
# As-of inventory RESTlet (optional)
NETSUITE_ASOF_SCRIPT_ID=
NETSUITE_ASOF_DEPLOY_ID=

# --- Stripe (credit-card payments — LIVE) -----------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Microsoft Graph via OAuth) --------------------------------------
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
# Test recipient for scripts/test-mail.ts (optional)
TEST_RECIPIENT=your-email@example.com

# --- Amazon SP-API (FBA monthly import) -------------------------------------
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_MARKETPLACE_ID=

# --- ShipHero / 3PL (designed, pending BrandFox tokens) ----------------------
SHIPHERO_ACCESS_TOKEN=
SHIPHERO_REFRESH_TOKEN=
# REQUIRED before ShipHero goes live — the webhook receiver fails closed
# without it (no secret = every payload rejected).
SHIPHERO_WEBHOOK_SECRET=
SHIPHERO_CUSTOMER_ACCOUNT_ID=
SHIPHERO_WAREHOUSE_ID=
SHIPHERO_SHOP_NAME=
SHIPHERO_DRY_RUN=

# --- DAM storage (AWS S3) ---------------------------------------------------
STORAGE_DRIVER=s3
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
SUPABASE_STORAGE_BUCKET=

# --- Cron (Vercel scheduled jobs authenticate with this) ---------------------
CRON_SECRET=

# --- Error monitoring (Sentry; inert when unset) -----------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Misc -------------------------------------------------------------------
# Set to disable rate limiting in local dev only
RATE_LIMIT_LENIENT=
