{
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/cron/amazon-fba-monthly/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/shopify-poll/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/shopify-reconcile/route.ts": {
      "maxDuration": 300
    },
    "app/api/netsuite/amazon-fba/push/route.ts": {
      "maxDuration": 300
    },
    "app/api/netsuite/amazon-fba/fetch-month/route.ts": {
      "maxDuration": 120
    },
    "app/api/amazon/dashboard/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/shopify-payouts/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/finance-reports/route.ts": {
      "maxDuration": 300
    },
    "app/api/shopify/reports/archive/route.ts": {
      "maxDuration": 300
    },
    "app/api/shopify/reports/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/amazon-fba-monthly",
      "schedule": "0 8 2 * *"
    },
    {
      "path": "/api/cron/amazon-fba-monthly?mode=remind",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/refresh-reports",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/refresh-invoices",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/shopify-poll",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/shopify-reconcile",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/cron/shopify-payouts",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/finance-reports",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron/shopify-watchdog",
      "schedule": "7,37 * * * *"
    },
    {
      "path": "/api/cron/fulfillment-poll",
      "schedule": "5,20,35,50 * * * *"
    }
  ]
}